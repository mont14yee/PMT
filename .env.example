# ==============================================================================
# Project Manager Autopilot Environment Configuration
# ==============================================================================

# Gemini AI API Configuration (Server-Side Only)
# AI Studio automatically injects this at runtime from user secrets.
# Used exclusively through secure backend proxy routes in server.ts
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Supabase Backend Configuration
# Obtain these from your Supabase Project Settings -> API
# If left blank, Project Manager Autopilot operates in "Explicit Demo Mode" with realistic 
# construction datasets while displaying the live connection setup interface.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# Supabase Service Role Key (Keep Strictly on Server - Never expose in client code or bundle)
SUPABASE_SERVICE_ROLE_KEY=""

# Background Job & Webhook Security
# Used to authenticate scheduled cron jobs hitting /api/jobs/monitor
CRON_SECRET=""
